# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://cattle_tracker:cattle_tracker@localhost:5432/cattle_tracker

# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-random-32-byte-hex-string
JWT_EXPIRES_IN=8h

MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=gateway
MQTT_PASSWORD=change-me-local-mqtt
MQTT_TELEMETRY_TOPIC=cattle-tracker/telemetry

# Shared secret gateways must send as the "x-gateway-key" header on POST /api/telemetry.
# Generate with: openssl rand -hex 32
GATEWAY_API_KEY=replace-with-a-random-32-byte-hex-string

CORS_ORIGIN=http://localhost:5173

DEVICE_ATTENTION_MINUTES=20
DEVICE_OFFLINE_MINUTES=60
DEVICE_LOW_BATTERY_PERCENT=20
